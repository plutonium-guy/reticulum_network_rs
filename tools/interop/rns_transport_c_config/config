[reticulum]
enable_transport = yes
share_instance = yes
instance_name = reticulum-rust-transport-c
shared_instance_port = 37433
instance_control_port = 37434

[logging]
loglevel = 6

[interfaces]

  [[Rust Transport C TCP Server]]
    type = TCPServerInterface
    enabled = yes
    listen_ip = 127.0.0.1
    listen_port = 42430
